.env
.env.*
!.env.example
.venv/
# Local Claude settings stay private; the review-workflow skills (R6) are
# versioned so /review-session and /implement-review travel with the repo.
.claude/*
!.claude/skills/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/
.DS_Store
*.log

# Release build output
dist/

# Runtime/private data
data/*
!data/.gitkeep
storage/*
!storage/.gitkeep
backups/*
!backups/.gitkeep
*.db
*.db-wal
*.db-shm
*.pre_migration_*.db

# IDE
.idea/

# Apple Health exports (user data)
HealthKit.zip
*.health_export
export*.zip

# Source-dump / recording archives must never be committed
*.zip
!tests/fixtures/
!tests/fixtures/*.zip

# QA screen recordings / personal capture (keep local, never commit)
*.docx
Recording_*

# Temporary files / generated logs
pytest_full.log
compileall.log
ruff.log
eval.log
*.tmp

# Review workflow (R4): raw evidence stays local — committable artifacts are
# manifest/stats/signals/findings/report only (see docs/CONTINUOUS_IMPROVEMENT_WORKFLOW.md)
reviews/state.json
reviews/state.json.tmp
reviews/.building_*
reviews/*/events.jsonl
reviews/*/timeline.md
